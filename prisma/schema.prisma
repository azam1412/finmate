generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum WalletType {
  CASH
  BANK
  EWALLET
  SAVINGS
  OTHER
}

enum CategoryType {
  INCOME
  EXPENSE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum TransactionStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum TransactionSource {
  TELEGRAM
  WEB
  WHATSAPP
}

model User {
  id           BigInt   @id @default(autoincrement())
  name         String   @db.VarChar(100)
  email        String?  @unique @db.VarChar(150)
  passwordHash String?  @map("password_hash") @db.VarChar(255)

  identities   ChannelIdentity[]
  wallets      Wallet[]
  categories   Category[]
  transactions Transaction[]

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model ChannelIdentity {
  id            BigInt   @id @default(autoincrement())
  userId        BigInt   @map("user_id")
  provider      String   @db.VarChar(20)
  providerUserId String  @map("provider_user_id") @db.VarChar(100)

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("channel_identities")
}

model Wallet {
  id             BigInt   @id @default(autoincrement())
  userId         BigInt   @map("user_id")
  name           String   @db.VarChar(100)
  type           WalletType
  initialBalance Decimal  @default(0) @map("initial_balance") @db.Decimal(15, 2)
  isActive       Boolean  @default(true) @map("is_active")

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions   Transaction[] @relation("SourceWallet")
  receivedTransactions Transaction[] @relation("DestinationWallet")

  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("wallets")
}

model Category {
  id           BigInt       @id @default(autoincrement())
  userId       BigInt?      @map("user_id")
  name         String       @db.VarChar(100)
  type         CategoryType
  icon         String?      @db.VarChar(50)

  user         User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id                  BigInt   @id @default(autoincrement())
  userId              BigInt   @map("user_id")
  walletId            BigInt   @map("wallet_id")
  destinationWalletId BigInt?  @map("destination_wallet_id")
  categoryId          BigInt?  @map("category_id")

  type                TransactionType
  amount              Decimal  @db.Decimal(15, 2)
  description         String?  @db.Text
  transactionDate     DateTime @map("transaction_date")
  status              TransactionStatus @default(PENDING)
  source              TransactionSource @default(TELEGRAM)

  idempotencyKey      String?  @unique @map("idempotency_key") @db.VarChar(150)
  cancelledAt         DateTime? @map("cancelled_at")

  user                User     @relation(fields: [userId], references: [id])
  wallet              Wallet   @relation("SourceWallet", fields: [walletId], references: [id])
  destinationWallet   Wallet?  @relation("DestinationWallet", fields: [destinationWalletId], references: [id])
  category            Category? @relation(fields: [categoryId], references: [id])

  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([userId, transactionDate])
  @@index([walletId])
  @@index([status])
  @@map("transactions")
}