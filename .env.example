# Salin file ini menjadi .env lalu isi nilainya. Jangan commit file .env.
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/finmate_db"
PORT=3000

# Mode satu pengguna (sementara): id pengguna dari tabel users (lihat Prisma Studio).
DEFAULT_USER_ID=1

# Keamanan HTTP (Stage 2.3a). Belum ada autentikasi, jadi API HANYA boleh berjalan di komputer lokal.
# Alamat yang didengarkan server. Biarkan 127.0.0.1 (hanya komputer ini).
BIND_HOST=127.0.0.1
# Origin browser yang boleh memanggil API (dipisah koma, tanpa tanda "/" di akhir). Kosong = tidak ada.
# Contoh dashboard lokal: CORS_ORIGINS=http://localhost:5173
CORS_ORIGINS=
